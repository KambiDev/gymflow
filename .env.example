# ── Base de datos ─────────────────────────────────────────────
# Desarrollo: levanta el Postgres local integrado de Prisma con
#   npx prisma dev -d
# y usa la URL TCP que muestra `npx prisma dev ls`.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ── Auth.js ───────────────────────────────────────────────────
# Genera uno con: npx auth secret
AUTH_SECRET=""

# ── Seed de desarrollo ────────────────────────────────────────
# Requeridas para ejecutar `npm run db:seed`. No se commitean.
SEED_OWNER_PASSWORD=""
SEED_DEMO_PASSWORD=""
