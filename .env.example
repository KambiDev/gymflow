# ── Base de datos ─────────────────────────────────────────────
# Desarrollo: levanta el Postgres local integrado de Prisma con
#   npx prisma dev -d
# y usa la URL TCP que muestra `npx prisma dev ls`.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Producción con pooler: usa DATABASE_URL para la app y la conexión directa
# DATABASE_URL_UNPOOLED solo para comandos Prisma (migraciones, introspección).
# No expongas la URL directa a funciones de aplicación o despliegues preview.
# DATABASE_URL_UNPOOLED="postgresql://..."

# ── Auth.js ───────────────────────────────────────────────────
# Genera uno con: npx auth secret
AUTH_SECRET=""
# Producción: URL pública HTTPS canónica del sitio (no usar localhost).
# AUTH_URL="https://tu-dominio.example"

# ── Seed de desarrollo ────────────────────────────────────────
# Requeridas para ejecutar `npm run db:seed`. No se commitean.
SEED_OWNER_PASSWORD=""
SEED_DEMO_PASSWORD=""
